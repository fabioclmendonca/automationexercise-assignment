{
  "name": "sokin-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation suite for automationexercise.com (SDET assignment)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:headed": "playwright test --project=chromium --project=firefox --project=webkit --headed",
    "test:ui": "playwright test --project=chromium",
    "test:ui-api": "playwright test --project=chromium --project=api",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  }
}
